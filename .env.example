# Loadstone Environment Variables
# Copy to .env and fill in values. NEVER commit .env.

# === Claude / Anthropic ===
# Required for the chat skills (/compass, /journal, etc.)
ANTHROPIC_API_KEY=sk-ant-...

# === Jira (Atlassian Cloud) ===
# JIRA_HOST: your Cloud instance hostname, e.g. "your-org.atlassian.net"
JIRA_HOST=your-org.atlassian.net
# JIRA_CLOUD_ID: UUID from your Atlassian admin / API endpoint
JIRA_CLOUD_ID=
JIRA_API_EMAIL=you@example.com
JIRA_API_TOKEN=
# Default project key for some skills, e.g. "PROJ"
JIRA_PROJECT_KEY=PROJ
# Board ID for jira_board_issues — find in the board URL
JIRA_BOARD_ID=
# Your own Jira account ID (used in some skill prompts to scope by user)
JIRA_USER_ACCOUNT_ID=

# === GitHub ===
GITHUB_TOKEN=ghp_...
GITHUB_ORG=your-org
# Default repo for "PR #1234" auto-linking when no repo context is given
GITHUB_DEFAULT_REPO=your-repo
GITHUB_USERNAME=your-github-username

# === Buildkite ===
BUILDKITE_API_TOKEN=bkua_...
BUILDKITE_ORG_SLUG=your-org

# === Slack (optional) ===
# SLACK_BOT_TOKEN=xoxb-...

# === Claude Code (for /ideas investigations) ===
# Path to the claude CLI. Leave as "claude" if on PATH.
CLAUDE_CLI=claude
# Working directory Claude Code runs in — ideally the folder containing your
# repos so it can grep them during investigations.
CLAUDE_WORKDIR=/Users/you/code
# Max seconds an investigation can run before being killed.
INVESTIGATION_TIMEOUT_SECONDS=1800
