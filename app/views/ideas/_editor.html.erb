<%= turbo_stream_from "idea_#{idea.id}" %>

<div id="idea_editor_<%= idea.id %>" data-controller="idea-editor" class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <%= form_with model: idea, url: idea_path(idea), method: :patch,
          data: { idea_editor_target: "form" }, class: "flex-1" do |f| %>
      <%= f.text_field :title,
            data: { action: "input->idea-editor#schedule" },
            class: "w-full bg-transparent text-2xl font-semibold border-b border-gray-700 focus:border-blue-500 focus:outline-none py-1" %>
      <%= f.text_area :body,
            data: {
              action: "input->idea-editor#schedule",
              idea_editor_target: "body"
            },
            placeholder: "Write your notes here. Markdown supported.",
            rows: 14,
            class: "w-full mt-4 bg-gray-900 border border-gray-700 rounded p-3 text-sm font-mono focus:border-blue-500 focus:outline-none" %>
    <% end %>

    <div class="flex items-center gap-2 ml-4">
      <%= button_to "Archive", archive_idea_path(idea),
            method: :patch,
            class: "text-xs text-gray-400 hover:text-white px-2 py-1" %>
      <%= button_to "Delete", idea_path(idea),
            method: :delete,
            data: { turbo_confirm: "Delete this idea and its investigations?" },
            class: "text-xs text-red-400 hover:text-red-300 px-2 py-1" %>
    </div>
  </div>

  <%= render "ideas/investigations", idea: idea %>
</div>
