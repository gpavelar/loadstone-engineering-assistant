<div class="flex h-screen w-full overflow-hidden bg-gray-900 text-gray-100">
  <header class="absolute top-0 left-0 right-0 flex items-center justify-between px-4 py-2 border-b border-gray-700 bg-gray-900 z-10">
    <h1 class="text-lg font-semibold">Ideas</h1>
    <%= link_to "← Conversations", conversations_path, class: "text-sm text-gray-400 hover:text-gray-200" %>
  </header>

  <aside class="flex w-72 flex-col border-r border-gray-700 bg-gray-950 pt-12">
    <div class="p-3 border-b border-gray-700">
      <%= form_with url: ideas_path, method: :post, class: "flex" do |f| %>
        <%= f.text_field :"idea[title]", placeholder: "+ Capture an idea…",
            autofocus: @idea.nil?,
              class: "w-full bg-gray-800 text-sm px-3 py-2 rounded border border-gray-700 focus:border-blue-500 focus:outline-none" %>
      <% end %>
    </div>

    <nav class="flex-1 overflow-y-auto p-2 space-y-1">
      <% @active_ideas.each do |idea| %>
        <%= render "idea_row", idea: idea, selected: (@idea && idea.id == @idea.id) %>
      <% end %>
    </nav>

    <% if @archived_ideas.any? %>
      <details class="border-t border-gray-800 text-xs">
        <summary class="px-3 py-2 text-gray-500 cursor-pointer">Archived (<%= @archived_ideas.size %>)</summary>
        <div class="p-2 space-y-1">
          <% @archived_ideas.each do |idea| %>
            <div class="flex items-center gap-2 px-2 py-1">
              <span class="flex-1 truncate text-gray-500"><%= idea.title %></span>
              <%= button_to "Restore", unarchive_idea_path(idea), method: :patch,
                    class: "text-xs text-blue-400 hover:text-blue-300" %>
              <%= button_to "Delete", idea_path(idea), method: :delete,
                    data: { turbo_confirm: "Delete permanently?" },
                    class: "text-xs text-red-400 hover:text-red-300" %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  </aside>

  <main class="flex-1 pt-12 p-6 overflow-y-auto">
    <% if @idea&.persisted? %>
      <%= render "editor", idea: @idea %>
    <% else %>
      <div class="text-center text-gray-500 mt-24">
        <p>No ideas yet.</p>
        <p class="text-sm mt-2">Type a title in the sidebar to capture one.</p>
      </div>
    <% end %>
  </main>
</div>
