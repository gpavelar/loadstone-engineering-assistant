<div class="flex justify-start" id="message_<%= message.id %>">
  <div class="max-w-2xl rounded-lg px-4 py-3 bg-gray-800 text-gray-100">
    <% if message.skill.present? && message.skill != "general" %>
      <span class="mb-2 inline-block rounded-full bg-gray-700 px-2 py-0.5 text-xs font-medium text-blue-300"><%= message.skill %></span>
    <% end %>
    <div class="prose prose-invert prose-sm max-w-none break-words" id="message_content_<%= message.id %>">
      <div class="flex items-center gap-2 text-gray-400 text-sm">
        <span class="animate-spin inline-block h-4 w-4 border-2 border-gray-400 border-t-transparent rounded-full"></span>
        <span><%= ["Aligning the magnetic field...", "Pulling signals toward you...", "Magnetising your priorities...", "Finding true north...", "Attracting the right data..."].sample %></span>
      </div>
    </div>
  </div>
</div>
